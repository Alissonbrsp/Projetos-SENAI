{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOwnTags",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeTags",
        "ec2:DescribeInstances"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Role": "ctf-arena"
        }
      }
    }
  ]
}
